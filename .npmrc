# Supply-chain hardening — pnpm 10+ blocks ALL dependency build/lifecycle
# scripts by default (the main malicious-package vector). Only the packages
# listed below in onlyBuiltDependencies are allowed to run their build scripts;
# everything else is denied silently + surfaced as a warning for review.
#
# esbuild: tsup's bundler — its postinstall installs the platform-specific
# binary. Trusted, dev-only, needed for all library builds.
engine-strict=true
