        "type": "function",
        "z": "86f1271d07a48b44w",
        "g": "fa79e06be881de74w",
        "name": "NMEA batch (all at once)",
        "func": "// A burst of NMEA sentences arriving together (e.g. a log dump).\nconst sentences = [\n  '$GPGGA,123519,4807.038,N,01131.000,E,1,08,0.9,545.4,M,46.9,M,,*47',\n  '$GPRMC,123519,A,4807.038,N,01131.000,E,022.4,084.4,230394,003.1,W*6A',\n  '$GPGSA,A,3,04,05,,09,12,,,24,,,,,2.5,1.3,2.1*39',\n  '$GPHDT,274.07,T*03',\n  '$GPVTG,054.7,T,034.4,M,005.5,N,010.2,K*48'\n]\n// join CRLF-terminated -> the parser returns one CMA[] with every sentence.\nreturn { payload: sentences.map(s => s + '\\r\\n').join('') }\n",
        "outputs": 1,
        "timeout": 0,
