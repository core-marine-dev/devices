    {
        "id": "fn-summary",
        "type": "function",
        "z": "sbf-tab",
        "g": "g-decoded",
        "name": "one line per block",
        "func": "// A readable summary of whatever came back, so the debug pane is legible.\nconst blocks = Array.isArray(msg.payload) ? msg.payload : null\nif (blocks === null) { return null }\nmsg.payload = blocks.map((cma) => ({\n  id: cma.id,\n  name: cma.metadata.name,\n  revision: cma.metadata.revision,\n  time: new Date(cma.timestamp).toISOString(),\n  fields: cma.payload.length,\n  errors: cma.errors,\n}))\nreturn msg",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 750,
        "y": 260,
        "wires": [
            [
                "dbg-summary"
            ]
        ]
    },
