{
  "name": "@coremarine/septentrio-sbf-nodered",
  "version": "2.0.0",
  "author": "CoreMarine",
  "license": "MIT",
  "description": "Node-RED component to read Septentrio SBF receiver output as CMA",
  "homepage": "https://github.com/core-marine-dev/devices/tree/main/packages/septentrio-sbf-nodered",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/core-marine-dev/devices.git",
    "directory": "packages/septentrio-sbf-nodered"
  },
  "bugs": {
    "url": "https://github.com/core-marine-dev/devices/issues"
  },
  "keywords": [
    "node-red",
    "iot",
    "cma",
    "septentrio",
    "sbf",
    "asterx",
    "gnss",
    "gps",
    "rtk",
    "parser",
    "binary",
    "protocol"
  ],
  "engines": {
    "node": ">=22"
  },
  "node-red": {
    "version": ">=4.0.0",
    "nodes": {
      "cma-septentrio-parser": "dist/parser.js"
    }
  },
  "main": "dist/parser.js",
  "files": [
    "dist",
    "examples",
    "!**/*.backup",
    "!**/*_cred.json"
  ],
  "scripts": {
    "build": "pnpm run format && tsup && node copy-assets.mjs",
    "lint": "eslint",
    "format": "eslint --fix",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include=\"src/**\" \"tests/**/*.test.ts\"",
    "test:unit": "node --import tsx --test \"tests/*.unit.test.ts\"",
    "test:integration": "node --import tsx --test \"tests/*.integration.test.ts\"",
    "dev": "pnpm run build && node dev-server.mjs dev",
    "examples": "pnpm run build && node dev-server.mjs examples"
  },
  "dependencies": {
    "@coremarine/septentrio-sbf": "workspace:^"
  },
  "devDependencies": {
    "@types/node-red": "1.3.5",
    "tsx": "4.23.1"
  }
}
