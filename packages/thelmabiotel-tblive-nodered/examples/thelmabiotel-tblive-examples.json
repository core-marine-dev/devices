    {
        "id": "tblive-split",
        "type": "function",
        "z": "tblive-tab",
        "g": "grp-out",
        "name": "clean / flagged / responses",
        "func": "// A CMA carries `errors` only when something went wrong, and a garbage\n// sentence has id \"unknown\". Anything that is not a CMA[] is a response to\n// one of the memory / firmware / ids / definition / fake keys.\nif (!Array.isArray(msg.payload)) return [null, null, msg]\nconst clean = msg.payload.filter((cma) => cma.errors === undefined)\nconst flagged = msg.payload.filter((cma) => cma.errors !== undefined)\nreturn [\n  clean.length ? { ...msg, payload: clean } : null,\n  flagged.length ? { ...msg, payload: flagged } : null,\n  null,\n]\n",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 880,
        "y": 120,
        "wires": [
            [
                "dbg-clean"
            ],
            [
                "dbg-flagged"
            ],
            [
                "dbg-resp"
            ]
        ]
    },
