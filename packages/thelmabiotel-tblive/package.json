{
  "name": "@coremarine/thelmabiotel-tblive",
  "version": "1.0.3",
  "description": "Library to work with Thlema Biotel TB-Lives hydrophones",
  "author": "CoreMarine",
  "license": "MIT",
  "homepage": "https://github.com/core-marine-dev/devices/tree/main/packages/thelmabiotel-tblive",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/core-marine-dev/devices.git",
    "directory": "packages/thelmabiotel-tblive"
  },
  "bugs": {
    "url": "https://github.com/core-marine-dev/devices/issues"
  },
  "keywords": [
    "hydrophone",
    "cma",
    "acoustic sensor",
    "acoustic detection",
    "tb-live",
    "thelma biotel"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm run format && tsup",
    "lint": "eslint",
    "format": "eslint --fix",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@schemasjs/valibot-numbers": "^1.1.1",
    "@schemasjs/validator": "^2.0.5",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@coremarine/protocol-core": "workspace:*"
  }
}
