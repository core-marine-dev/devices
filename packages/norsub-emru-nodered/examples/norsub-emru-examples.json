    {
        "id": "fn-split",
        "type": "function",
        "z": "norsub-examples-tab",
        "g": "g-parse",
        "name": "send PNORSUB8 in 2 halves",
        "func": "const s = \"$PNORSUB8,1234567,890,1.234,-0.567,123.456,0.101,-0.202,0.303,0.012,-0.034,0.056,0.021,-0.043,0.065,0.077,-0.088,9.807,7.1,8.2,9.3,0.41,0.52,0.63,4160749567*40\\r\\n\"\nconst cut = Math.floor(s.length / 2)\nnode.send({ payload: s.slice(0, cut) })\nreturn { payload: s.slice(cut) }",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 420,
        "wires": [
