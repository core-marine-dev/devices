{
  "name": "@coremarine/nmea-parser",
  "version": "6.0.0",
  "description": "Library to parse NMEA 0183 sentences",
  "author": "CoreMarine",
  "license": "MIT",
  "homepage": "https://github.com/core-marine-dev/devices/tree/main/packages/nmea-parser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/core-marine-dev/devices.git",
    "directory": "packages/nmea-parser"
  },
  "bugs": {
    "url": "https://github.com/core-marine-dev/devices/issues"
  },
  "keywords": [
    "cma",
    "nmea",
    "nmea0183",
    "0183",
    "gps",
    "gnss"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "protocols": "node ../../scripts/yaml-to-ts.mjs ./protocols/nmea.yml ./src/nmea.ts --name=PROTOCOLS --type=ProtocolsFileContent --type-from=./types && node ../../scripts/yaml-to-ts.mjs ./protocols/norsub.yml ./tests/norsub.ts --name=PROTOCOLS --type=ProtocolsFileContent --type-from=../src/types",
    "build": "pnpm run protocols && pnpm run format && tsup",
    "lint": "eslint",
    "format": "eslint --fix",
    "test": "pnpm run protocols && vitest",
    "test:coverage": "pnpm run protocols && vitest run --coverage"
  },
  "dependencies": {
    "@schemasjs/valibot-numbers": "^1.1.1",
    "@schemasjs/validator": "^2.0.5",
    "@valibot/to-json-schema": "1.7.1",
    "js-yaml": "4.2.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@coremarine/protocol-core": "workspace:*",
    "@types/js-yaml": "4.0.9"
  }
}
