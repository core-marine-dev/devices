{
  "name": "@coremarine/septentrio-sbf",
  "version": "2.0.0",
  "author": "CoreMarine",
  "description": "Library to parse SBF (Septentrio Binary Format) data from Septentrio GNSS receivers, with every documented block decoded",
  "license": "MIT",
  "homepage": "https://github.com/core-marine-dev/devices/tree/main/packages/septentrio-sbf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/core-marine-dev/devices.git",
    "directory": "packages/septentrio-sbf"
  },
  "bugs": {
    "url": "https://github.com/core-marine-dev/devices/issues"
  },
  "keywords": [
    "coremarine",
    "core-marine",
    "septentrio",
    "sbf",
    "asterx",
    "gnss",
    "gps",
    "rtk",
    "binary",
    "protocol"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm run format && tsup",
    "lint": "eslint",
    "format": "eslint --fix",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "crc": "^4.3.2"
  },
  "devDependencies": {
    "@coremarine/protocol-core": "workspace:*"
  }
}
