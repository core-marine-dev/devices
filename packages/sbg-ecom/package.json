{
  "name": "@coremarine/sbg-ecom",
  "version": "1.0.0",
  "description": "Parser for the SBG Systems sbgECom binary protocol (ELLIPSE, EKINOX, APOGEE), emitting the unified CoreMarine CMA format",
  "author": "CoreMarine",
  "license": "MIT",
  "homepage": "https://github.com/core-marine-dev/devices/tree/main/packages/sbg-ecom",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/core-marine-dev/devices.git",
    "directory": "packages/sbg-ecom"
  },
  "bugs": {
    "url": "https://github.com/core-marine-dev/devices/issues"
  },
  "keywords": [
    "sbg",
    "ecom",
    "sbgECom",
    "imu",
    "mru",
    "gnss",
    "gps",
    "binary",
    "protocol"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm run format && tsup",
    "lint": "eslint",
    "format": "eslint --fix",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@coremarine/protocol-core": "workspace:^",
    "@coremarine/nmea-parser": "workspace:^",
    "crc": "^4.3.2"
  }
}
