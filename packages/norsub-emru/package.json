{
  "name": "@coremarine/norsub-emru",
  "version": "3.0.0",
  "description": "Library to work with eMRU devices of NorSub company",
  "author": "Core Marine",
  "license": "MIT",
  "homepage": "https://github.com/core-marine-dev/devices/tree/main/packages/norsub-emru",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/core-marine-dev/devices.git",
    "directory": "packages/norsub-emru"
  },
  "bugs": {
    "url": "https://github.com/core-marine-dev/devices/issues"
  },
  "keywords": [
    "mru",
    "imu",
    "norsub",
    "norwegian subsea",
    "iot",
    "nmea",
    "nmea-0183"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "protocols": "node ../../scripts/yaml-to-ts.mjs ./protocols/norsub.yml ./src/norsub.ts --name=NORSUB_SENTENCES --type=ProtocolsFileContent --type-from=@coremarine/nmea-parser",
    "build": "pnpm run protocols && pnpm run format && tsup",
    "lint": "eslint",
    "format": "eslint --fix",
    "test": "pnpm run protocols && vitest",
    "test:coverage": "pnpm run protocols && vitest run --coverage"
  },
  "dependencies": {
    "@coremarine/nmea-parser": "workspace:^",
    "@schemasjs/valibot-numbers": "^1.1.1",
    "@schemasjs/validator": "^2.0.5"
  },
  "peerDependencies": {
    "valibot": "1.4.2"
  }
}
